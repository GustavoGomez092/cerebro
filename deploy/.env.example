# Copy to deploy/.env. deploy/zima/deploy.sh reads only OLLAMA_CPUS and BGE_M3_DIGEST from it.
#
# Data and secrets dirs, for a plain `docker compose --env-file deploy/.env` run only: on the Zima host they are
# fixed in deploy/zima/lib.sh (DATA, SECRETS) and deploy.sh ignores these two lines.
CEREBRO_DATA=/DATA/AppData/cerebro/data
CEREBRO_SECRETS=/DATA/AppData/cerebro/secrets
# The server image tag; deploy.sh sets it to the git SHA7 of the release.
CEREBRO_TAG=REPLACE_WITH_GIT_SHA7
# Ollama CPU cap; the benchmark may adjust this.
OLLAMA_CPUS=4
# bge-m3's Ollama digest (`ollama list` ID or the full sha256 from /api/tags), recorded by the benchmark.
# deploy/zima/deploy.sh refuses to switch servers when the pulled model doesn't match.
BGE_M3_DIGEST=

# The summariser's settings are not read from this file: they live in ${CEREBRO_SECRETS}/server.env, which
# deploy.sh --first-run writes once (SUMMARY_SHARE=0.2, SUBSCRIPTION_TOKENS_PER_5H=2000000, SUMMARISER_ENABLED=true).
# Each has that default in server/src/config.ts, as does SUMMARISER_CMD (claude), so a server.env from before the
# summariser still starts. To change one, edit server.env on the server and redeploy. SUMMARISER_ENABLED accepts
# true/false, 1/0, yes/no, on/off; any other value stops the server at startup.
