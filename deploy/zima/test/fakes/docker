#!/bin/bash
# Fake docker. State in $FAKE_STATE: `running` = image of cerebro-server, `images` = known tags.
echo "docker $*" >> "$FAKE_LOG"
st=$FAKE_STATE
case $1 in
  inspect) [[ -s $st/running ]] || { echo "Error: No such object" >&2; exit 1; }; cat "$st/running"; exit 0 ;;
  image) grep -qxF -- "${*: -1}" "$st/images" 2>/dev/null; exit ;;
  images) [[ -f $st/images ]] && sort -u "$st/images"; exit 0 ;;
  rmi)
    shift
    for t in "$@"; do grep -vxF -- "$t" "$st/images" > "$st/images.tmp"; mv "$st/images.tmp" "$st/images"; done
    exit 0 ;;
  builder) exit 0 ;;
  build)
    # FAKE_STEAL_LOCK: another deploy takes over the lock while this one builds.
    if [[ -n ${FAKE_STEAL_LOCK-} ]]; then
      printf 'zzz9999 from thief at 2026-11-14T00:00:00Z\n' > "$FAKE_ROOT/DATA/AppData/cerebro/state/deploy.lock/owner"
    fi
    rc=${FAKE_BUILD_RC:-0}
    while (($#)); do [[ $1 == -t && $rc == 0 ]] && echo "$2" >> "$st/images"; shift; done
    exit "$rc" ;;
  tag) echo "$3" >> "$st/images"; exit 0 ;;
  compose)
    shift; file=; sub=
    while (($#)); do
      case $1 in
        -f|-p|--env-file) [[ $1 == -f ]] && file=$2; shift 2 ;;
        -*) shift ;;
        *) sub=$1; shift; break ;;
      esac
    done
    case $sub in
      up) # FAKE_UP_DEPS_RC: db/ollama of the release being deployed (the .next compose) fail to come up.
          if [[ " $* " != *" server "* && $file == *.next.yml && -n ${FAKE_UP_DEPS_RC-} ]]; then exit "$FAKE_UP_DEPS_RC"; fi
          if [[ " $* " == *" server "* ]]; then
            img=$(sed -n 's/^ *image: *\(cerebro-server:.*\)$/\1/p' "$file")
            echo "compose-up-server $img" >> "$FAKE_LOG"
            if [[ $img == cerebro-server:prev ]]; then rc=${FAKE_UP_PREV_RC:-0}; else rc=${FAKE_UP_RC:-0}; fi
            # A failed recreate has already removed the old container.
            if [[ $rc == 0 ]]; then echo "$img" > "$st/running"; else : > "$st/running"; exit "$rc"; fi
          fi ;;
      run) if [[ "$*" == *migrate* ]]; then
             if [[ ${FAKE_TERM_AT-} == migrate ]]; then term-deploy; exit 1; fi
             printf '%s\n' "${FAKE_MIGRATE_OUT:-migrations up to date}"; exit "${FAKE_MIGRATE_RC:-0}"
           fi ;;
    esac
    exit 0 ;;
  run)
    # One-off `ollama pull`: write the model manifest into the mounted models dir.
    if [[ "$*" == *"ollama pull"* ]]; then
      v=; prev=; for a in "$@"; do [[ $prev == -v ]] && v=${a%%:*}; prev=$a; done
      m=$v/models/manifests/registry.ollama.ai/library/bge-m3; mkdir -p "$m"; printf '%s' "$FAKE_MANIFEST" > "$m/latest"
    fi
    exit 0 ;;
  exec)
    case "$*" in
      *pg_dump*) printf '%s' "${FAKE_DUMP_CONTENT:-PGDMP-fake}"; exit "${FAKE_DUMP_RC:-0}" ;;
      *"token create check"*)
        printf 'Token for check (shown once, store it on that machine):\n%s\nDo not create tokens inside a recorded Claude Code session.\n' "$FAKE_CHECK_TOKEN"
        exit 0 ;;
      *) printf '%s\n' "${FAKE_OLLAMA_LIST-}"; exit 0 ;;
    esac ;;
  stats) printf '%s\n' "${FAKE_STATS-}"; exit 0 ;;
esac
exit 0
