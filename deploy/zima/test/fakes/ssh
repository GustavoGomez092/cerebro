#!/bin/bash
# Fake ssh: logs its options, drops them and the host, maps /DATA and /var/lib/casaos into $FAKE_ROOT,
# and runs the command locally.
opts=()
while (($#)); do
  case $1 in
    -o|-p|-i|-l|-F) opts+=("$1 $2"); shift 2 ;;
    -*) opts+=("$1"); shift ;;
    *) break ;;
  esac
done
host=$1; shift
cmd="$*"
cmd=${cmd//\/var\/lib\/casaos\//$FAKE_ROOT/var/lib/casaos/}
cmd=${cmd//\/DATA\//$FAKE_ROOT/DATA/}
printf 'ssh [%s] %s %s\n' "${opts[*]}" "$host" "$cmd" >> "$FAKE_LOG"
exec bash -c "$cmd"
