#!/bin/bash
# Fake curl. Server /health is healthy for every tag unless FAKE_HEALTHY_TAGS lists the healthy ones;
# FAKE_HEALTH_LOCAL / FAKE_HEALTH_LAN override the bodies; /v1/status needs the bearer header on stdin (-H @-).
# FAKE_TERM_PATTERN (with FAKE_TERM_AT unset or "health"): the first health poll of a non-prev release
# interrupts the deploy script; FAKE_TERM_REPEAT interrupts it on every poll, prev's included.
echo "curl $*" >> "$FAKE_LOG"
url=${*: -1}; hdr=
for a in "$@"; do [[ $a == @- ]] && hdr=$(cat); done
case $url in
  http://cerebro.home.lab/health) [[ -n ${FAKE_HEALTH_LAN-} ]] || exit 7; printf '%s' "$FAKE_HEALTH_LAN" ;;
  */health)
    if [[ -n ${FAKE_HEALTH_LOCAL-} ]]; then printf '%s' "$FAKE_HEALTH_LOCAL"; exit 0; fi
    run=$(cat "$FAKE_STATE/running" 2>/dev/null); tag=${run#*:}
    if [[ -n ${FAKE_TERM_PATTERN-} && ${FAKE_TERM_AT:-health} == health ]]; then
      if [[ -n ${FAKE_TERM_REPEAT-} || ( $tag != prev && ! -e $FAKE_STATE/termed ) ]]; then
        : > "$FAKE_STATE/termed"
        term-deploy
        [[ $tag == prev ]] || exit 7
      fi
    fi
    if [[ -n $run && ( -z ${FAKE_HEALTHY_TAGS+x} || " $FAKE_HEALTHY_TAGS " == *" $tag "* ) ]]; then
      printf '{"ok":true,"db":true,"apiVersion":1,"instanceId":"%s"}' "${FAKE_INSTANCE:-inst-1}"
    else exit 7; fi ;;
  */v1/status) [[ $hdr == "Authorization: Bearer ${FAKE_TOKEN-}" ]] || exit 22; printf '%s' "$FAKE_STATUS" ;;
  *) exit 6 ;;
esac
