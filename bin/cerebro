#!/bin/sh
# Runs the cerebro binary built for this Mac's CPU. If it is missing, do nothing and succeed,
# so a broken install never blocks a Claude Code session.
dir=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd) || exit 0
case "$(uname -m 2>/dev/null)" in
  arm64|aarch64) arch=arm64 ;;
  x86_64|amd64) arch=x64 ;;
  *) exit 0 ;;
esac
bin="$dir/cerebro-darwin-$arch"
[ -x "$bin" ] || exit 0
exec "$bin" "$@"
