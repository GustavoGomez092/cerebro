{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "DOM.AsyncIterable", "ES2024"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": false,
    "types": ["bun", "vite/client"]
  },
  "include": ["src", "scripts", "test", "server.ts", "vite.config.ts"]
}
